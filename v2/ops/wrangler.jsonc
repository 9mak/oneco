// oneco v2 の配信設定（Cloudflare Workers の静的アセット配信）。
// 2026-09-30 時点、Cloudflare Pages の新規プロジェクトは Workers（static assets）に統合されているので、
// `wrangler pages deploy` ではなく `wrangler deploy --config v2/ops/wrangler.jsonc` で site/dist を丸ごと置く。
// スクリプトは無く、assets だけの Worker。URL は https://oneco.<アカウントのサブドメイン>.workers.dev と、
// ダッシュボード（Workers & Pages → oneco → Settings → Domains & Routes）で付ける独自ドメイン。
{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "oneco",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../site/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true
}
