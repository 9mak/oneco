# oneco v2 日次収集の環境変数（Mac の launchd 版）。~/.config/oneco/collect.env に写して埋める（chmod 600）。
# 値の取り方は docs/OPERATIONS.md の 1-1（Cloudflare）と 1-3（通知）。
# 空のままでもよいもの: DISCORD_WEBHOOK_URL（無ければ表示だけ）、HEALTHCHECK_URL（無ければ飛ばす）、
#                       ANTHROPIC_API_KEY / ONECO_AI_REPAIR（無ければ AI 修復をしない）。
# CLOUDFLARE_* と ONECO_PAGES_PROJECT の 3 つが揃わないと deploy を飛ばす（収集とサイト生成だけ動く）。

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ONECO_PAGES_PROJECT=oneco

DISCORD_WEBHOOK_URL=
HEALTHCHECK_URL=

# AI 修復を使うとき
# ANTHROPIC_API_KEY=
# ONECO_AI_REPAIR=1
