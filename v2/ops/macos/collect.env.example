# oneco v2 日次収集の環境変数（Mac の launchd 版）。~/.config/oneco/collect.env に写して埋める（chmod 600）。
# 値の取り方は docs/OPERATIONS.md の 1-1（Cloudflare）と 1-3（通知）。
# 空のままでもよいもの: DISCORD_WEBHOOK_URL（無ければ表示だけ）、HEALTHCHECK_URL（無ければ飛ばす）、
# ONECO_PAGES_PROJECT が無いと deploy を飛ばす（収集とサイト生成だけ動く）。
# 手元の Mac では `npx wrangler login`（ブラウザで許可）で保存される OAuth を wrangler が使うので、
# CLOUDFLARE_API_TOKEN は空でよい。VPS など別マシンで動かすときだけ API トークンを入れる。

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ONECO_PAGES_PROJECT=oneco

DISCORD_WEBHOOK_URL=
HEALTHCHECK_URL=

# AI 修復を使うとき
# ONECO_AI_REPAIR=1
